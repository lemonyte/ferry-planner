{
    "name": "ferry-planner",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "wrangler types && vite build",
        "preview": "wrangler dev --port 4173",
        "deploy": "bun run build && wrangler deploy",
        "prepare": "svelte-kit sync || echo ''",
        "check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker && biome check",
        "format": "biome check --write",
        "test": "vitest run"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@sveltejs/adapter-cloudflare": "^8.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@tailwindcss/vite": "^4.3.0",
        "@types/node": "^26.6.4",
        "svelte": "^5.57.1",
        "svelte-check": "^4.6.0",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.0",
        "vitest": "^4.1.8",
        "wrangler": "^4.97.0"
    },
    "imports": {
        "#lib/*": "./src/lib/*",
        "#test/*": "./test/*"
    },
    "dependencies": {
        "@lucide/svelte": "^1.52.0",
        "bits-ui": "^2.19.5",
        "fflate": "^0.8.3"
    }
}
