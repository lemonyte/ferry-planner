{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "ferry-planner-backend",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-07",
    "compatibility_flags": ["nodejs_compat"],
    "observability": {
        "enabled": true,
        "logs": { "enabled": true, "head_sampling_rate": 1 },
        "traces": { "enabled": true, "head_sampling_rate": 0.01 }
    },
    "triggers": {
        // Check for a new GTFS feed every hour.
        "crons": ["0 * * * *"]
    },
    "durable_objects": {
        "bindings": [{ "name": "PLANNER", "class_name": "Planner" }]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Planner"] }]
}
