{
    "$schema": "node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true,
        "root": ".."
    },
    "files": {
        "includes": ["**", "!worker-configuration.d.ts"]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 119
    },
    "linter": {
        "rules": {
            "preset": "recommended"
        }
    },
    "html": {
        "experimentalFullSupportEnabled": true,
        "formatter": { "enabled": true }
    }
}
