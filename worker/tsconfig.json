{
    "compilerOptions": {
        "target": "es2024",
        "lib": ["es2024"],
        "module": "es2022",
        "moduleResolution": "bundler",
        "types": ["node"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noEmit": true,
        "isolatedModules": true,
        "skipLibCheck": true
    },
    "include": ["worker-configuration.d.ts", "src/**/*.ts"]
}
