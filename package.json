{
    "name": "ferry-planner",
    "private": true,
    "type": "module",
    "imports": {
        "#lib/*": "./src/lib/*",
        "#test/*": "./test/*"
    },
    "scripts": {
        "dev": "vite dev",
        "build": "wrangler types && vite build",
        "preview": "wrangler dev --port 4173",
        "deploy": "bun run build && wrangler deploy",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker",
        "test": "vitest run",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check"
    },
    "dependencies": {
        "fflate": "^0.8.3"
    },
    "devDependencies": {
        "@fontsource/fira-sans-condensed": "^5.3.0",
        "@lucide/svelte": "^1.60.0",
        "@sveltejs/adapter-cloudflare": "^8.0.1",
        "@sveltejs/kit": "^3.1.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.5",
        "bits-ui": "^2.19.5",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.89.0",
        "oxlint-tsgolint": "^7.0.2004",
        "super-sitemap": "^2.0.6",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.7",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.3.4",
        "vitest": "^5.0.5",
        "wrangler": "^4.151.3"
    }
}
